#!/bin/sh
# script for starting NetRexx script interpret only
# works with zsh

if test "$(echo $CLASSPATH | grep 'NetRexx.\.jar')" = ""; then
  thisdir=$(dirname "$0")
  export CLASSPATH="$thisdir/../lib/NetRexxF.jar:.:$CLASSPATH"
fi  

if test $# -eq 0; then
  echo 'Usage:' "$0" 'filename [arguments]'
  exit 1
fi

# the program, then every argument after it -- not just the first eight
prog=$1
shift
nrc -verbose0 -noconsole "$prog" -arg "$@"

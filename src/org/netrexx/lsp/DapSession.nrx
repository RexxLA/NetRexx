/* ------------------------------------------------------------------ */
/* 2026.08.03 MRE Initial                                             */
/* 2026.10.16 breakpoints update                                --MRE */
/* 2026.11.11 multi-threaded debuggee support (all-stop)        --MRE */
/* 2026.11.13 per-thread stop mode, selected by --pt option     --MRE */
/* ------------------------------------------------------------------ */


/* DapSession.nrx
   ------------------------------------------------------------------
   The hand-off point between the DAP server thread and the threads
   that run the debuggee:

     - DapServer.run()          -- reads DAP requests from stdin, one
                                    at a time, and dispatches them
     - InterpreterThread.run()  -- executes the debuggee's main program
     - any thread the debuggee starts (GO, java.lang.Thread)

   Every debuggee thread calls checkLine() at each statement (or
   whatever granularity you want breakpoints/stepping to have). If
   that line is a breakpoint, or the thread is stepping, or a pause was
   requested, checkLine() sends a "stopped" event to the client and
   BLOCKS that thread on its own one-slot queue (DapThreadState).

   Stop policy is chosen from Settings, option -pt:
     'all'    (default) ALL-STOP, described below
     'thread' PER-THREAD: a thread that hits a breakpoint, finishes a
              step or is paused stops ALONE (allThreadsStopped=false);
              every other thread keeps running, and may stop on its
              own, so several threads can be stopped at the same time.
              continue/next/stepIn/stepOut then resume only the thread
              named in the request. 'pause' stops only the named thread.

   ALL-STOP: The first thread to stop announces the stop
   (allThreadsStopped=true) and sets allStop. Every other debuggee
   thread parks at its next statement, silently, so the client can
   inspect all of them. Stopping is cooperative: a thread blocked in
   sleep/IO/wait stops when it wakes up and reaches its next statement.

   continue/next/stepIn/stepOut for thread T wakes every parked thread.
   T gets the real command; the others always get 'continue', so only
   T steps while the rest run (the same as gdb with scheduler-locking
   off).

   Locking:
     - resume() never blocks, so the DAP thread cannot be stuck waiting
       on a debuggee thread.
     - 'gate' only makes "decide to park" and "release everyone" atomic
       (otherwise a thread could park just after resume() looked at it
       and sleep forever). It is never held across a blocking call; the
       take() on the per-thread queue happens outside it.
     - breakpoints are guarded by the session monitor (synchronized
       methods); they are short and never block.
   ------------------------------------------------------------------ */

package org.netrexx.lsp

import java.util.
import java.util.concurrent.
import java.util.concurrent.atomic.
import java.util.concurrent.locks.
import org.netrexx.process

options nobinary

class DapSession extends org.netrexx.process.NetRexxC implements Runnable public

properties public

  handler = DapHandler

  breakpointId = 0
  breakpoints = Rexx ''

  breakPerLine = int 0
  breakPerThread = int 0

  -- one DapThreadState per debuggee thread
  threadStates  = ConcurrentHashMap     -- Thread  -> DapThreadState
  idStates      = ConcurrentHashMap     -- Integer threadId -> DapThreadState
  nextThreadId  = AtomicInteger
  debuggeeGroup = ThreadGroup           -- every debuggee thread lives in here

  allStop  = AtomicBoolean              -- true while the debuggee is stopped
  pauseReq = AtomicBoolean              -- set by a DAP 'pause' request (all-stop, or no usable threadId)
  pauseIds = ConcurrentHashMap          -- Integer threadId -> pause requested for that thread (per-thread mode)
  gate     = ReentrantLock

  -- args built by connect(), consumed by run() on the interpreter thread
  interpArgs = String[]

  -- frameId/variablesReference -> object (DapRef, or a value being expanded)
  varRefMap  = ConcurrentHashMap
  nextVarRef = AtomicInteger            -- 1001-1003 are no longer fixed: scopes are registered per frame

properties public volatile
  terminated = boolean 0
  liveErrors = int 0                    -- getLiveValue failures seen so far (diagnostics)



method DapSession(handler_ = DapHandler)
  handler       = handler_
  threadStates  = ConcurrentHashMap()
  idStates      = ConcurrentHashMap()
  nextThreadId  = AtomicInteger(1)
  debuggeeGroup = ThreadGroup('debuggee')
  allStop       = AtomicBoolean(boolean 0)
  pauseReq      = AtomicBoolean(boolean 0)
  pauseIds      = ConcurrentHashMap()
  gate          = ReentrantLock()
  terminated    = boolean 0
  perThread     = boolean 0
  varRefMap     = ConcurrentHashMap()
  nextVarRef    = AtomicInteger(2000)

  return


  -- ------------------------------------------------------------
  -- DAP-thread side
  -- ------------------------------------------------------------

  -- Builds the nrc argument vector, stashes it, and hands off to a
  -- dedicated InterpreterThread so the caller (the DAP thread reading
  -- stdin) never blocks on the debuggee's execution. Actual startup
  -- happens in run(), below, on that new thread.
  method connect(prog = Rexx, progargs = Rexx, cwd = Rexx)
    nrcArgs = Rexx '-nocolor -arg 'progargs
    c = nrcArgs.words()
    -- Split 'prog' into one or more program-name tokens.
    -- A name containing a blank or a quote must be wrapped in ' ' (single quotes);
    -- a literal quote inside such a name is written as '' (doubled).
    progNames = ''
    n = 0
    s = prog.strip()
    loop while s.length() > 0
      s = s.strip('L')
      if s.length() = 0 then leave
      if s.substr(1,1) = "'" then do
        -- quoted token
        token = ''
        s = s.substr(2)
        loop forever
          p = s.pos("'")
          if p = 0 then do
            -- unterminated quote: take the rest as-is
            token = token || s
            s = ''
            leave
          end
          token = token || s.substr(1, p - 1)
          s = s.substr(p + 1)
          if s.substr(1,1) = "'" then do
            -- doubled quote -> literal quote char, keep scanning
            token = token || "'"
            s = s.substr(2)
          end
          else leave                    -- real closing quote found
        end
      end
      else do
        -- plain token up to the next blank
        p = s.pos(' ')
        if p = 0 then do
          token = s
          s = ''
        end
        else do
          token = s.substr(1, p - 1)
          s = s.substr(p + 1)
        end
      end
      n = n + 1
      progNames[n] = token
    end

    args = String[n + c]
    loop i = 1 to n
      args[i - 1] = String(progNames[i])
    end
    loop i = 1 to c
      args[n + i - 1] = String(nrcArgs.word(i))
    end

    interpArgs = args

    -- the debuggee's threads all inherit this group, which is how
    -- liveStates() finds threads that have not reached a statement yet
    interpreterThread = Thread(debuggeeGroup, this)
    interpreterThread.setName('main')
    interpreterThread.setDaemon(boolean 0)
    interpreterThread.start()
    return

  -- Runs on InterpreterThread. Loads NetRexxC and invokes main3(),
  -- which drives the debuggee and calls back into checkLine() as it
  -- executes -- that's what may block this thread on its resume queue,
  -- and it's fine for it to block here since it's off the DAP thread.
  method run()

    register(Thread.currentThread())      -- first registrant gets threadId 1

    do

      RexxIO.setOutputStream(DapOutputStream(handler, Rexx 'console'))

      clss =  Class.forName(String "org.netrexx.process.NetRexxC")

      paramTypes = Class[2]
      paramTypes[0] = String[].class
      paramTypes[1] = org.netrexx.lsp.DapSession.class
      m = clss.getMethod("main3", paramTypes)               -- get a handle on main3 for reflection call
                                                            -- pass it the parameters
      params = Object[2]
      params[0] = interpArgs
      params[1] = this   -- Pass 'this' DapSession instance

      say "== Invoking NetRexxC"
      result = m.invoke(null, params)                       -- and invoke main3
      say '== NetRexxC returned: ' result

    catch e=Exception
      do
        say 'NetRexxC exception: ' e
      end
    finally
      RexxIO.popOutputStream()
    end

    -- The program is over when its last thread ends, not when the main
    -- one does: threads started by GO may still be running, and they
    -- must stay debuggable.
    if debuggeeGroup.activeCount() <= 1 then setTerminated(boolean 1)
    return

  -- ------------------------------------------------------------
  -- thread registry
  -- ------------------------------------------------------------

  -- Idempotent: returns the existing state if the thread is known.
  -- Safe to race (the thread itself vs. the DAP thread listing threads).
  method register(t = Thread) returns DapThreadState
    fresh = DapThreadState(nextThreadId.getAndIncrement(), t)
    old   = DapThreadState threadStates.putIfAbsent(t, fresh)
    if old \= null then return old
    idStates.put(Integer.valueOf(fresh.id), fresh)
    handler.sendEvent('thread', '{"reason": "started", "threadId": 'fresh.id'}')
    return fresh

  -- state of the calling thread, registering it on first use
  method stateFor() returns DapThreadState
    st = DapThreadState threadStates.get(Thread.currentThread())
    if st = null then st = register(Thread.currentThread())
    return st

  -- diagnostics: debuggee threads that are registered and not stopped right now
  method runningThreads() returns int
    n  = int 0
    it = threadStates.values().iterator()
    loop while it.hasNext()
      o = DapThreadState it.next()
      if \o.paused then n = n + 1
    end
    return n

  method stateById(threadId = int) returns DapThreadState
    return DapThreadState idStates.get(Integer.valueOf(threadId))

  -- DAP thread: the live debuggee threads, newest registrations
  -- included; threads that have died are reported once as exited.
  method liveStates() returns ArrayList
    grp = debuggeeGroup
    arr = Thread[grp.activeCount() + 8]
    n   = grp.enumerate(arr, boolean 1)
    loop i = int 0 for n
      register(arr[i])
    end

    result = ArrayList()
    it = threadStates.values().iterator()
    loop while it.hasNext()
      st = DapThreadState it.next()
      if st.jthread.isAlive() then result.add(st)
       else if \st.exited then do
        st.exited = boolean 1
        threadStates.remove(st.jthread)
        idStates.remove(Integer.valueOf(st.id))
        handler.sendEvent('thread', '{"reason": "exited", "threadId": 'st.id'}')
      end
    end
    return result


  -- ------------------------------------------------------------
  -- variable references (frames, scopes, expandable values)
  -- ------------------------------------------------------------

  method registerVarRef(obj = Object) returns int
    ref = nextVarRef.getAndIncrement()
    varRefMap.put(Integer.valueOf(ref), obj)
    return ref

  method resolveVarRef(ref = int) returns Object
    return varRefMap.get(Integer.valueOf(ref))

  method clearVarRefs()
    varRefMap.clear()
    nextVarRef.set(2000)
    return

  -- per-thread mode: drop only the frame/scope refs of the thread being
  -- resumed. Other threads are still stopped and the client still holds
  -- their frameIds and variablesReferences.
  method clearVarRefsFor(st = DapThreadState)
    it = varRefMap.values().iterator()
    loop while it.hasNext()
      v = Object it.next()
      if v <= DapRef then do
        fr = DapRef v
        if fr.state = st then it.remove()
      end
    end
    return


  -- ------------------------------------------------------------
  -- breakpoints: written by the DAP thread, read by every debuggee thread
  -- ------------------------------------------------------------

  method clearBreakpoints(path) protect
    breakpoints[path] = null
    it = threadStates.values().iterator()      -- re-arm the same-line check
    loop while it.hasNext()
      st = DapThreadState it.next()
      st.prevPath = ''
      st.prevLine = ''
    end


  method addBreakpoint(path = Rexx, line = Rexx, cond = String null) protect
    breakpointId = breakpointId + 1
    if \breakpoints.exists(path) then breakpoints[path] = 1
    breakpoints[path, line] = breakpointId
    return breakpointId


-- a line can have multiple clauses
-- we pause once per (possibly multi clause) line, unless option --cl where we pause per clause (so possibly multiple 'steps' per line)
  method isBreakpoint(st = DapThreadState, path = Rexx, line = Rexx) protect

    sameLine = (path == st.prevPath) & (line == st.prevLine)
    st.prevPath = path                     -- always update, so leaving the line resets it
    st.prevLine = line

    if \breakpoints.exists(path) then return ''
    if \breakpoints[path].exists(line) then return ''

    if sameLine & breakPerLine \= 1 then return ''   -- same line, no --cl option

    return breakpoints[path, line]


  -- ------------------------------------------------------------
  -- DAP-thread side: resuming
  -- ------------------------------------------------------------

  -- called from onContinue / onNext / onStepIn / onStepOut / onDisconnect.
  -- Wakes every parked thread; threadId gets 'command', all others 'continue'.
  -- Never blocks.
  method resume(command = Rexx, threadId = int, singleOnly = boolean 0)
    if command = 'terminate' then setTerminated(boolean 1)

    if breakPerThread & singleOnly & command \= 'terminate' then do
      resumeOne(command, threadId)         -- only the named thread moves
      return
    end

    clearVarRefs()                         -- before releasing anyone, or we'd wipe refs they register next

    gate.lock()
    do
      allStop.set(boolean 0)
      it = threadStates.values().iterator()
      loop while it.hasNext()
        st = DapThreadState it.next()
        if \st.paused then iterate
        st.paused = boolean 0              -- cleared here, so a second resume() cannot double-offer
        -- offer Rexx objects: a bare literal would go in as a java.lang.String
        if command = 'terminate' then st.resumeQueue.offer(Rexx 'terminate')
         else if st.id = threadId then st.resumeQueue.offer(Rexx command)
         else st.resumeQueue.offer(Rexx 'continue')
      end
    finally
      gate.unlock()
    end
    return

  -- per-thread mode: release one thread, leave every other stopped thread alone.
  -- Never blocks.
  method resumeOne(command = Rexx, threadId = int)
    st = stateById(threadId)
    if st = null then return

    gate.lock()
    do
      if st.paused then do
        -- if other threads are still stopped, keep the refs the client
        -- still uses for them; only the last one to go wipes everything
        othersPaused = boolean 0
        it = threadStates.values().iterator()
        loop while it.hasNext()
          o = DapThreadState it.next()
          if o \= st & o.paused then othersPaused = boolean 1
        end
        if othersPaused then clearVarRefsFor(st)
         else clearVarRefs()

        st.paused = boolean 0
        st.resumeQueue.offer(Rexx command)
      end
    finally
      gate.unlock()
    end
    return

  -- DAP 'pause'.
  -- All-stop: the first debuggee thread to reach a statement stops
  -- (and, being all-stop, takes the others with it).
  -- Per-thread: the named thread stops at its next statement, alone.
  -- Without a usable threadId, the first thread to reach a statement stops.
  method requestPause(threadId = int)
    if breakPerThread & threadId > 0 then
      if stateById(threadId) \= null then do
        pauseIds.put(Integer.valueOf(threadId), Boolean.TRUE)
        return
      end
    pauseReq.set(boolean 1)
    return

  method isbreakPerThread() returns boolean
    return boolean breakPerThread

  -- ------------------------------------------------------------
  -- interpreter-thread side
  -- ------------------------------------------------------------

  -- Called by RxInterpreter.callMethod around a method body, so each
  -- thread has a real call stack (stackTrace, next/stepOut depth).
  method enterMethod(cursor = Object, methodName = String, path = String)
    stateFor().frames.add(DapFrame(cursor, methodName, path, 0))
    return

  method exitMethod(cursor = Object)
    fr = stateFor().frames
    n  = fr.size()
    if n > 0 then do
      idx = int
      idx = n - 1
      fr.remove(idx)
    end
    return

  -- Called once per statement/line, on the debuggee thread that executes it.
  -- Returns the command that let execution continue ('run' if it never
  -- stopped), so the caller can react to 'terminate'.
  method checkLine(path = Rexx, line = int, frame = Object) returns Rexx

    if isTerminated() then return 'terminate'

    st = stateFor()
    st.noteLine(frame, line)

    bp       = isBreakpoint(st, path, line)
    pauseHit = pauseReq.compareAndSet(boolean 1, boolean 0)
    if \pauseIds.isEmpty() then                        -- cheap guard, this runs for every statement
      if pauseIds.remove(Integer.valueOf(st.id)) \= null then pauseHit = boolean 1

    stepHit = boolean 0
    if st.singleStep then do
      depth = st.frames.size()
      select
        when st.stepMode = 'in'   then stepHit = boolean 1
        when st.stepMode = 'over' then stepHit = (depth <= st.stepDepth)
        when st.stepMode = 'out'  then stepHit = (depth <  st.stepDepth)
        otherwise nop
      end
      -- several clauses on one line: stay quiet on the same line at the
      -- same depth, unless --cl asked for a stop per clause
      if stepHit & breakPerLine \= 1 & depth = st.stepDepth & line = st.prevStepLine then stepHit = boolean 0
    end

    reason = ''
    if bp \= '' then reason = 'breakpoint'
     else if pauseHit then reason = 'pause'
     else if stepHit then reason = 'step'

    -- stop for our own reason, or because another thread already stopped the world
    if reason \= '' | allStop.get() then return pauseAndWait(st, path, line, frame, bp, reason)
    return 'run'


  method pauseAndWait(st = DapThreadState, path = Rexx, line = int, frame = Object, bp = Rexx, reason = Rexx) returns Rexx

    cmd = Rexx 'continue'

    loop forever
      announce = boolean 0
      parked   = boolean 0

      -- decide atomically with resume(): either we park and resume() sees
      -- us, or resume() already ran and we do not park at all
      gate.lock()
      do
        select
          when breakPerThread then do                         -- this thread stops alone and announces itself
            announce = boolean 1
            st.snapshot(frame, path, line)
            st.paused = boolean 1
            parked = boolean 1
          end
          when reason = '' & \allStop.get() then nop     -- the stop ended while we were getting here
          otherwise do
            announce = allStop.compareAndSet(boolean 0, boolean 1)   -- only the first stopper announces
            st.snapshot(frame, path, line)
            st.paused = boolean 1
            parked = boolean 1
          end
        end
      finally
        gate.unlock()
      end

      if \parked then return 'run'

      if announce then do
        allFlag = 'true'
        if breakPerThread then allFlag = 'false'
        body = '{"reason": "'reason'", "threadId": 'st.id', "allThreadsStopped": 'allFlag
        if bp \= '' then body = body', "hitBreakpointIds": ['bp']'
        body = body'}'
        handler.sendEvent('stopped', String body)
      end

      do
        cmd = Rexx(st.resumeQueue.take().toString())   -- blocks here until resume() fires, outside any lock
      catch InterruptedException
        cmd = 'terminate'
      end

      -- We parked silently behind another thread's stop but had hit a
      -- breakpoint of our own: once released, report it instead of
      -- swallowing it.
      if \announce & bp \= '' & cmd = 'continue' then iterate
      leave
    end

    st.paused = boolean 0

    select
      when cmd = 'next' | cmd = 'stepIn' | cmd = 'stepOut' then do
        st.singleStep   = boolean 1
        st.prevStepLine = line
        st.stepDepth    = st.frames.size()
        if cmd = 'next' then st.stepMode = 'over'
         else if cmd = 'stepOut' then st.stepMode = 'out'
         else st.stepMode = 'in'
      end
      otherwise st.singleStep = boolean 0
    end
    return cmd


  -- cursor of some stopped thread. Only used to reach the interpreter
  -- when expanding objects, arrays and stems, so any stopped thread will do.
  -- Scopes carry their own exact cursor (DapRef).
  method getCurrentCursor() returns RxCursor
    it = threadStates.values().iterator()
    loop while it.hasNext()
      st = DapThreadState it.next()
      if st.paused then do
        snap = st.frameSnap
        if snap \= null then if snap.length > 0 then do
          idx = int
          idx = snap.length - 1
          return RxCursor snap[idx].cursor
        end
      end
    end
    return RxCursor null


  -- ------------------------------------------------------------
  -- accessors
  -- ------------------------------------------------------------
  method setTerminated(isSet = boolean)
    terminated = isSet
    return

  method isTerminated() returns boolean
    return terminated


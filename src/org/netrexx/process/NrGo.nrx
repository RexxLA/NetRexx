/* NrGo                                                               */
/*                                                                    */
/*   An object that represents a parsed go clause                     */
/*                                                                    */
/* ------------------------------------------------------------------ */
/* Change list                                                        */
/* 2025.10.04 MRE Initial                                             */
/* 2025.12.19 MRE immutable variables for lambda expression           */
/* 2026.05.13 MRE snapshot method arguments when interpret            */
/* 2026.09.28 MRE nullify newcursor.curlpool                          */
/* ------------------------------------------------------------------ */


package org.netrexx.process
options binary nodecimal strictcase strictargs

class NrGo implements RxClauseParser, Runnable
 properties private
  rxt     =RxTranslator   -- root
  parser  =RxParser       -- local reference
  tokens  =RxToken[]      -- local reference
  code    =RxCode
  cursor  =RxCursor
  finals  =Rexx           -- immutable final copies of arguments
  capturedArgCodes =RxCode[]       -- snapshotted argument codes  (interpret)
  capturedField    =RxField        -- snapshotted method field    (interpret)
  capturedObject   =Object         -- snapshotted object          (interpret)

 /** Construct an object from the current clause */
 method NrGo(newrxt=RxTranslator)
  rxt    =newrxt                                  -- the boss
  parser =rxt.program.parser
  tokens =parser.cursor.curclause.tokens

/** Construct an instance from a cursor, termparser, and pre-captured
    argument snapshot. Used exclusively by interpret(). */
 method NrGo(newRxt=RxTranslator, newcursor=RxCursor, -
             newArgCodes=RxCode[], newField=RxField, newObject=Object null)
   rxt              = newRxt
   cursor           = newcursor
   capturedArgCodes = newArgCodes
   capturedField    = newField
   capturedObject   = newObject

 /** Pass processing */
 method scan(pass=int)
  if pass<2 then signal RxQuit(rxt, tokens[0], 'internal.error', 'NrGo', pass)
  if tokens[1].type=RxToken.END then do
    signal RxError(rxt, tokens[1],  'method.expected')
  end

--  if tokens[1].type=RxToken.SP then begin=2; else begin=1  -- should be two

  parser.cursor.curIsGO = 1                                  -- set parsing GO instruction
  code=rxt.tparser.parseterm(parser.cursor, 2, 0)            
  parser.cursor.curIsGO = 0                                  -- unset

  if code.group \== RxCode.S_METHOD then do                  -- not a method
    signal RxError(rxt, tokens[2],  'method.expected')
  end
  if tokens[code.endoff+1].type \== RxToken.END then do      -- can be followed by methodcall only
    signal RxError(rxt, tokens[code.endoff+1], 'bad.expression.syntax')
  end
                          -- parseterm massages the java code for GO instruction, vars need to be immutable
                          -- temp '$'variables are prefix between ';' which is java code to include before lambda

  finals = ''
  if code.javacode.substr(1,1) == ';' then do              -- get final variable definitions
    lpos = Rexx code.javacode.lastpos(';')
    finals = code.javacode.substr(1,lpos)
    code.javacode = code.javacode.substr(lpos.OpAdd(null, 1))
  end
  return

 /** Trace names list */
 method getAssigns returns String[]
  return null


 /** code generation [only] */
 method generate
  -- generate java code to run the given method as a thread
  -- we use uniques + 1 for the Throwable

  uniq = '$$'parser.cursor.curclass.uniques+1        -- $$ definitively unique
  prefix = '{' finals '{new Thread(() -> { try {'
  postfix = ';}catch (Throwable 'uniq') {'-
      'System.out.println("Throwable:"+'uniq'.getClass().getName()+'-
      '" at 'rxt.program.programname' in method " +'-
      '('uniq'.getStackTrace())[0].getMethodName()+ " (" +'-
      '('uniq'.getStackTrace())[0].getFileName()+ " line " +'-
      '('uniq'.getStackTrace())[0].getLineNumber() + ")" );'-
      ''uniq'.printStackTrace(System.out);}'-
   '}).start();}}'


  if code=null then jcode='""'
  else do
    jcode=prefix''code.javacode''postfix
  end
  rxt.program.streamer.out(jcode)

 --  say '.. 'jcode

 /** Interpretation */
 method interpret(tcursor=RxCursor null)
  if code = null then return

  -- Snapshot argument values on the calling (main) thread.
  -- rxt.tparser.snapshotGoArgs() parses the argument list with exec=1
  -- so every RxCode[i].value reflects the current variable state,
  -- but does NOT invoke the target method.

  snapshot = rxt.tparser.snapshotGoArgs(tcursor, 2)   -- token 2 = method name

  -- create a new cursor, and assign our needed properties
  newcursor = RxCursor(rxt.program, tcursor.curclass, tcursor.curmethod, tcursor.curclause)
  newcursor.curexec = tcursor.curexec     -- yes, we're exec-ing..
  newcursor.curlpool = null               -- callMethod will initialize
  newcursor.curthis  = tcursor.curthis
--  say '....'newcursor.curclause.showtokens()

  -- create a new GO instance to run method on a newly started thread
  r = NrGo(rxt, newcursor, snapshot.argCodes, snapshot.field, snapshot.targetObj)
  t = Thread(r)
  t.start()
  return

--
--    When capturedField is non-null the argument values were already
--    evaluated on the calling thread; call callMethod() directly with
--    the captured RxCode[] (whose .value fields hold the snapshots).
--    This mirrors the compiled 'final $copy' variables exactly.

  method run()
   -- interpreter is running in a new thread (started by interpret above)
   do
     if capturedField \= null then do
       -- Use pre-snapshotted argument values: mirrors compiled 'final $copy'
       rxt.interpreter.callMethod(capturedObject, capturedField,-
                                  capturedArgCodes, cursor.curclause.tokens[2])
     end
     else do
       -- Fallback: full re-parse (no snapshot available)
       code = rxt.tparser.parseterm(cursor, 2, 0)
     end
   catch s = RxSignal
     say s.toString()' at 'cursor.curprogram.programname' line 's.signaltoken.line' pos 's.signaltoken.pos
   catch e = RxError
     say e.toString()' at 'cursor.curprogram.programname
   end  

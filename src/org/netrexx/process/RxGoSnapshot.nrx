/* ------------------------------------------------------------------ */
/* RxGoSnapshot                                                       */
/*                                                                    */
/*   Value object carrying the pre-evaluated argument snapshot        */
/*   produced by RxTermParser.snapshotGoArgs() for a GO instruction.  */
/*                                                                    */
/*   This is the interpret-time counterpart to the 'final $copy'      */
/*   variables that the compiler emits for GO lambda captures.        */
/*                                                                    */
/* ------------------------------------------------------------------ */
/* Change list                                                        */
/* 2026.05.13 MRE Initial                                             */
/* ------------------------------------------------------------------ */

package org.netrexx.process
options binary nodecimal strictcase strictargs

class RxGoSnapshot

 properties public
  argCodes =RxCode[]   -- evaluated argument codes (.value is set for each)
  field    =RxField    -- resolved target method field
  tokStart =RxToken    -- method-name token (for error reporting in run())
  targetObj =Object     -- evaluated receiver: null for static, instance for obj.method()

 method RxGoSnapshot(codes=RxCode[], f=RxField, tok=RxToken, obj=Object null)
  argCodes  = codes
  field     = f
  tokStart  = tok
  targetObj = obj
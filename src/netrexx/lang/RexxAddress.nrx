import java.util
package netrexx.lang
options binary strictargs decimal noformat

/*
Major changes with issue #94
Now 'system' command is started by the shell with $shell -c command
aka $comspec /c command.
It separates command's input from shell's input.
Non-system commands still share the same input stream provided by WITH,
i.e. $environment is started, command is fed into its standard input,
and command is reading the same standard input.

Note, any unconsumed input to non-system commands is fed into
$environment itself. The environment and any command it starts may consume
from the same input stream.
System commands are protected from this.

RC is threadlocal, i.e. per thread.
system environment defaults to /bin/sh if no shell found
Fix deadlocks on large input or heavy stderr: feed stdin and drain stderr
on separate threads.
A BadArgumentException is thrown and shown on stdout when input stem[0]
is not a number.
*/

/**
   This defines the external command utility class for NetRexx.
 */
    
class RexxAddress implements Serializable 

  properties private static
    StdOut = ConcurrentLinkedDeque()
    exitcode = ThreadLocal()                  -- RC per thread
    sysaddr  = Rexx ''                        -- look up once
    isWindows = System.getProperty('os.name').toLowerCase().startsWith('windows')

  properties private constant unused
  serialVersionUID=long 2781762092115528702

  method RC() static returns Rexx
    r = exitcode.get()
    if r = null then return Rexx 'RC'           -- never set: return 'RC'
    return Rexx r

 /** Method to launch an executable and process a command with redirection.
     Arg1 is the executable to launch.
     Arg2 is the command to process, it is sent into STDIN of the started executable
     Arg3 either null or stdin as stem or stream
     Arg4 either null or stdout as stem or stream
     Arg5 whether to append to stdout
     Arg6 either null or stderr as stem or stream
     Arg7 whether to append to stderr
     
     Input if present as stem or stream is fed into 'addr command_'
     Output of the processed executable command is printed on
     STDOUT, or if present added to ostem or ostream.
     Error output of the processed executable command is printed on
     STDERR, or if present added to estem or estream.

     Returncode is stored on lastrc 
   */

  method execAddress(addr=String, command_=Rexx,   i=Object, o=Object, oappend=int, e=Object, eappend=int, srcinfo_=String) static signals IOException, InterruptedException, BadArgumentException
    execAddress(addr,String command_,i,o,oappend,e,eappend,srcinfo_)

  method execAddress(addr=String, command_=String, i=Object, o=Object, oappend=int, e=Object, eappend=int, srcinfo_=String) static signals IOException, InterruptedException, BadArgumentException
--    trace results
    istem=Rexx
    ostem=Rexx
    estem=Rexx

    iReader=BufferedReader
    oWriter=BufferedWriter
    eWriter=BufferedWriter

    isSystemcmd= 0
    if addr == 'SYSTEM' then do
      addr=getSystemAddressee()                            -- OS hard-coded environments, resolve at runtime
      isSystemcmd=1
    end
--    srcinfo.set(srcinfo_)
    do              -- catching exceptions IOException and InterruptedException 
        
      if i = null then do
        istem=Rexx null
        iReader=BufferedReader null
      end  
      else if i.getClass().getName() = 'netrexx.lang.Rexx' then
        istem=Rexx i
      else if i.getClass().getName() = 'java.lang.String' then do
        istream=String i
        ifile=File(istream)
        iReader=BufferedReader(InputStreamReader(FileInputStream(ifile)))
      end  

      if o = null then do
        ostem=Rexx null 
        oWriter=BufferedWriter null
      end
      else if o.getClass().getName() = 'netrexx.lang.Rexx' then
        ostem=Rexx o
      else if o.getClass().getName() = 'java.lang.String' then do
        ostream=String o
        ofile=File(ostream)
        oWriter=BufferedWriter(OutputStreamWriter(FileOutputStream(ofile,oappend)))
      end  
      
      if e = null then do
        estem=Rexx null
        eWriter=BufferedWriter null
      end
      else if e.getClass().getName() = 'netrexx.lang.Rexx' then
        estem=Rexx e
      else if e.getClass().getName() = 'java.lang.String' then do
        estream=String e
        efile=File(estream)
        eWriter=BufferedWriter(OutputStreamWriter(FileOutputStream(efile, eappend)))
      end  

      if isSystemcmd then do
        if isWindows then
          addressee=[addr, '/c', command_]
        else
          addressee=[addr, '-c', command_]   -- POSIX
      end
      else
        addressee=[addr]

      pb = ProcessBuilder(addressee)
      pid = pb.start()
      in = BufferedReader(InputStreamReader(pid.getInputStream()))
      out = BufferedWriter(OutputStreamWriter(pid.getOutputStream()))
      err = BufferedReader(InputStreamReader(pid.getErrorStream()))

      if estem\=null then do 
        if \eappend then do
          estem['0']=0
        end  
      end  
      if ostem\=null then do
        if \oappend then do
          ostem['0']=0
        end
      end

      if \isSystemcmd then do              -- environments read the command from stdin
        out.write(command_'\n')            -- write command, new line and flush
        out.flush()
      end

      feedSource = StdinFeeder(out, istem, iReader, srcinfo_)     -- writes stdin, then closes it
      feeder = Thread(feedSource)
      feeder.setDaemon(boolean 1)
      feeder.start()

      drainSink = StderrDrain(err, estem, eWriter)      -- reads stderr until EOF
      drain = Thread(drainSink)
      drain.setDaemon(boolean 1)
      drain.start()

      line = in.readLine()                 -- main thread: stdout, unchanged
      loop while line <> null
        if ostem\=null then do
          j=ostem['0']
          j=j+1
          ostem[j]= line
          ostem['0']=j
        end
        else if oWriter\=null then do
          line=line'\n'
          oWriter.write(line, 0, line.length())
        end
        else do
          Say(line)
        end
        line = in.readLine()
      end
      if oWriter\=null then
        oWriter.close()

      feeder.join()
      drain.join()

	    pid.waitFor()
      exitcode.set(Rexx pid.exitValue())

      if feedSource.iofailure\=null then do
        exitcode.set(Rexx '')               -- set empty
        signal feedSource.iofailure
      end
      else if feedSource.argfailure\=null then do
        exitcode.set(Rexx '')               -- set empty
        signal feedSource.argfailure
      end
      if drainSink.iofailure\=null then do
        exitcode.set(Rexx '')               -- set empty
        signal IOException(drainSink.iofailure)
      end

    catch iox=IOException                 -- this also catches FileNotFound
      exitcode.set(Rexx '')               -- set empty
      signal IOException(iox.getMessage())
    catch InterruptedException
      exitcode.set(Rexx '')               -- set empty
      signal InterruptedException()
    end -- do
    return

/** get default addressee per OS */
method getSystemAddressee static returns String
  
  if sysaddr == '' then do 
    os=Rexx System.getProperty('os.name')
    os=os.lower()

    shell = System.getenv('SHELL')
    if shell == null then shell = '/bin/sh'
    else if shell == '' then shell = '/bin/sh'

    if      os.pos('linux')   >> 0 then sysaddr=shell
    else if os.pos('mac os')  >> 0 then sysaddr=shell
    else if os.pos('windows') >> 0 then do 
                                        sysaddr=System.getenv('COMSPEC')
                                        if sysaddr == null then sysaddr = 'cmd.exe'
                                        if sysaddr == ''   then sysaddr = 'cmd.exe'
                                        sysaddr=sysaddr.changestr('\\', '/')  -- freaking backslash ..
    end
    else                                sysaddr=shell
  end   
  
  return sysaddr



    
  /** Function to write a line to the standard output stream.
     Arg1 is the Object or Rexx string to be written.
     If the line ends in the NUL character ('\-' or '\0') then no
     line termination is provided (and the NUL is deleted).
     If the write succeeds 0 is returned, otherwise 1 is returned.
     
     We handle all the well-known character forms directly to
     minimize code generation in caller; null is allowed for all
     objects.
     We also handle Object here, so null can be processed efficiently.
     We provide versions for all the other primitives, too.
   */

-- Borrowed from RexxIO    
  method Say(aline=char[]) static returns boolean
    do protect StdOut
      if StdOut.isEmpty() then StdOut.push(PrintWriter(System.out))
    end
--    if StdOut.size() == 0 then StdOut.push(PrintWriter(System.out))
    i = StdOut.iterator()
    loop while i.hasNext()
      out=PrintWriter i.next()
      if aline=null then out.println()      -- just new line
      else do                                 -- have some data
	      select
          when aline.length=0 then out.println()
          when aline[aline.length-1]\=='\-' then out.println(aline)
          otherwise                            -- rarer continuation case
            bline=char[aline.length-1]
            System.arraycopy(aline, 0, bline, 0, bline.length)
            out.print(bline)
        end
      end
      out.flush()  -- could be a real user out there
    end -- loop while i
    return 0

/** Feeds stdin of the child from a stem or a file, then closes it.
    A child that exits without reading everything is not an error,
    as in a shell pipeline. */
class RexxAddress.StdinFeeder implements Runnable

  properties public
    iofailure = IOException null
    argfailure = BadArgumentException null

  properties private
    out     = BufferedWriter
    istem   = Rexx
    iReader = BufferedReader
    srcinfo = Rexx

  method StdinFeeder(o=BufferedWriter, s=Rexx, r=BufferedReader, srcinfo_=Rexx)
    out=o
    istem=s
    iReader=r
    srcinfo=srcinfo_

  method run
    do
      if istem\=null then do
        if \(istem[0]).datatype('D') then do           -- must be digits
          parse srcinfo stemname '-' info
          signal BadArgumentException(stemname'[0] must be a number for ADDRESS INPUT STEM ('info')')
        end

        loop j=1 to istem[0]
          out.write(istem[j]'\n')
          out.flush()
        end
      end
      else if iReader\=null then do
        line = iReader.readLine()
        loop while line <> null
          out.write(line'\n')
          out.flush()
          line = iReader.readLine()
        end
      end
    catch iox = IOException
      iofailure = iox                    -- broken pipe
    catch bae = BadArgumentException
      argfailure = bae
    finally
      do
        out.close()
      catch iox = IOException
        iofailure = iox
      end
      if iReader\=null then do
        do
          iReader.close()
        catch iox = IOException
          iofailure = iox
        end
      end
    end


/** Reads stderr of the child until EOF into a stem, a stream, or System.err.
    A failure is kept for the caller to rethrow after join(). */
class RexxAddress.StderrDrain implements Runnable

  properties public
    iofailure = IOException null

  properties private
    err     = BufferedReader
    estem   = Rexx
    eWriter = BufferedWriter

  method StderrDrain(e=BufferedReader, s=Rexx, w=BufferedWriter)
    err=e
    estem=s
    eWriter=w

  method run
    do
      eline = err.readLine()
      loop while eline <> null
        if estem\=null then do
          j=estem['0']
          j=j+1
          estem[j]= eline
          estem['0']=j
        end
        else if eWriter\=null then do
          eline=eline'\n'
          eWriter.write(eline, 0, eline.length())
        end
        else do
          System.err.println(eline)
        end
        eline = err.readLine()
      end
      if eWriter\=null then
        eWriter.close()
    catch iox = IOException
      iofailure=iox
    end
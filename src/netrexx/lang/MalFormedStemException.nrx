/* ------------------------------------------------------------------ */
/* netrexx.lang.MalFormedStemException                                */
/* ------------------------------------------------------------------ */
/* Author: MRE                                                        */
/*                                                                    */
/* Must be compiled with binary defaults; must not use Rexx class     */
/* Can be thrown when a stem[0] is expected,                          */
/*  and either [0] is not numeric,                                    */
/*  or not all indexes up to [0] are defined                          */
/* ------------------------------------------------------------------ */
/* 2026.09.28 Initial version in NetRexx                              */
package netrexx.lang
options binary strictargs nodecimal

/**
   Signals that a select construct with no Otherwise was
   processed without any of the When clauses being successful.
 */
class MalFormedStemException extends RuntimeException
  properties private constant unused
  serialVersionUID=long -6463998224063381724

  /**
     Constructs a NoOtherwiseException with no detail message.
     A detail message is a String that describes this particular exception.
   */
  method MalFormedStemException; super()

  /**
     Constructs a NoOtherwiseException with a detail message.
     A detail message is a String that describes this particular exception.
   */
  method MalFormedStemException(arg=String); super(arg)

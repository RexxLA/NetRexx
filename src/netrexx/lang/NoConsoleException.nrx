/* netrexx.lang.NoConsoleException                                    */
/* ------------------------------------------------------------------ */
/*                                                                    */
/* Must be compiled with binary defaults; must not use Rexx class     */
/* ------------------------------------------------------------------ */
/* 26.11.07 Initial version                                           */
package netrexx.lang
options binary strictargs nodecimal

/**
   Signals that AskNoEcho could not access the console, console is
   needed to readPassword. Use -askstdin to avoid this exception.
 */
class NoConsoleException extends RuntimeException

  properties private constant unused
  serialVersionUID=long -8888165251054317527

  /**
     Constructs a NoConsoleException with no detail message.
     A detail message is a String that describes this particular exception.
   */
  method NoConsoleException; super()

  /**
     Constructs a NoConsoleException with a detail message.
     A detail message is a String that describes this particular exception.
   */
  method NoConsoleException(arg=String); super(arg)
